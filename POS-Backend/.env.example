# Environment Variables Template (POS-Backend)
# Copy this file to .env and fill in your actual values.
# NEVER commit real credentials to Git.

PORT=5050
DATABASE_URL=postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require
JWT_SECRET=your-secure-random-jwt-secret-key

# Legacy MongoDB (Decoupled in Phase 2B; retained only for rollback reference)
# MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/POS?retryWrites=true&w=majority

# Optional external integrations
TWILIO_SID=your-twilio-sid
TWILIO_AUTH=your-twilio-auth-token
TWILIO_FROM=+1234567890
